# Wzór zmiennych środowiskowych. Nie commituj prawdziwego .env.
# docker compose czyta plik .env sam; `flask run` NIE (brak python-dotenv) – lokalnie ustaw zmienne w powłoce,
# np. bash: export DEMO_ACCOUNTS=1   PowerShell: $env:DEMO_ACCOUNTS=1
SECRET_KEY=YOUR_KEY_HERE
# Opcjonalnie – bez klucza działają wersje regułowe i szablony
ANTHROPIC_API_KEY=YOUR_KEY_HERE
ANTHROPIC_MODEL=claude-haiku-4-5
AI_DAILY_LIMIT=300
AI_DISABLED=0
# 1 za HTTPS (Coolify), 0 lokalnie po http
COOKIE_SECURE=0
# 1 = konta demo bez haseł (lokalnie); DEMO_MODE=1 = publiczne demo (włącza też konta demo)
DEMO_ACCOUNTS=1
DEMO_MODE=0
# Ścieżka pliku SQLite (domyślnie instance/hugme.db)
DATABASE=instance/hugme.db
